{
  "name": "wunderstack",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @wunderstack/embed build && pnpm --filter runtime build && pnpm --filter playground build && pnpm --filter dashboard build && pnpm --filter marketing build && pnpm --filter roleplay build",
    "start": "pnpm --filter runtime start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "depcruise": "depcruise apps packages scripts",
    "check-ui-boundaries": "bash scripts/check-ui-boundaries.sh",
    "check-motion": "bash scripts/check-motion.sh",
    "check-grants": "bash scripts/check-grants.sh",
    "bake-off": "pnpm --filter @wunderstack/bake-off bake-off",
    "promote-check": "pnpm --filter @wunderstack/promote check",
    "seed:oomt": "pnpm --filter @wunderstack/ingest seed:oomt",
    "db:provision-fund": "pnpm --filter @wunderstack/db-scripts provision",
    "db:compare-retrieval": "pnpm --filter @wunderstack/db-scripts compare-retrieval",
    "db:migrate-fund-schemas": "pnpm --filter @wunderstack/db-scripts migrate-fund-schemas",
    "db:drop-public-corpus": "pnpm --filter @wunderstack/db-scripts drop-public-corpus",
    "db:revoke-public-fund-grants": "pnpm --filter @wunderstack/db-scripts revoke-public-fund-grants",
    "db:grant-reader": "pnpm --filter @wunderstack/db-scripts grant-reader",
    "db:inspect-grants": "pnpm --filter @wunderstack/db-scripts inspect-grants"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.0",
    "dependency-cruiser": "18.0.0",
    "eslint": "10.6.0",
    "turbo": "2.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  }
}
