node_modules/
.turbo/
dist/
.next/
out/
*.tsbuildinfo

# pnpm content-addressable store (local cache, never commit)
.pnpm-store/

# Local env files (never commit secrets)
.env
.env.*
!.env.example

# Per-run eval artefact (E9) — uploaded by CI, never committed.
eval-report.json

# Local baseline diagnostic dumps (throwaway; regenerated on demand).
baseline-v4-*-dump.json

# Scratch and debug output. scripts/check-root.sh sends throwaway files here, so it has
# to be ignored for that advice to hold.
tmp/
# tsx write cache (distinct from tmp/); must not be committed.
.tmp/

.DS_Store
