{
  "name": "@wunderstack/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./evals/fund-ledger": {
      "types": "./src/evals/fund-ledger.ts",
      "default": "./src/evals/fund-ledger.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "tsx --test 'src/**/*.test.ts'",
    "test": "tsx --env-file-if-exists=../../.env src/evals/cao.eval.ts",
    "smoke": "tsx --env-file-if-exists=../../.env src/smoke.ts",
    "sync-model-prices": "tsx --env-file-if-exists=../../.env src/sync-model-prices.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "eslint": "10.6.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@ai-sdk/provider": "2.0.3",
    "@mastra/core": "^1.48.0",
    "@mastra/langfuse": "^1.4.2",
    "@mastra/observability": "^1.15.2",
    "@wunderstack/ai": "workspace:*",
    "@wunderstack/rag": "workspace:*",
    "@wunderstack/shared": "workspace:*",
    "zod": "4.4.3"
  }
}
