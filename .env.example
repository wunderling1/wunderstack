# Wunderstack environment variables (example — no real values here).
#
# Keys are added per PLAN.md phase, not up front:
# Only add a key here once the code that reads it exists.

# Runtime environment. One of: development | test | production
NODE_ENV=development

# Scalingo managed Postgres (with pgvector). Used by @wunderstack/db and drizzle-kit.
# Example shape (no real values): postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Mistral (FR/EU) — default sovereign LLM provider. Used by @wunderstack/ai.
MISTRAL_API_KEY=

# Scaleway Generative APIs (EU) secret key — embeddings + reranking. Used by @wunderstack/ai.
SCALEWAY_API_KEY=

# Rerank pipeline (Fase 9). Uses SCALEWAY_API_KEY above; optional overrides:
# RERANK_ENABLED=true
# RERANK_MODEL=qwen3-embedding-8b
# RERANK_CANDIDATE_K=15
# RERANK_TOP_K=3
# RERANK_SKIP_ABOVE_SCORE=0.85

# --- Ingestion chunker (scripts/ingest/run.ts) ---
# Optional overrides for the chunker; unset = the chunker's built-in defaults. Validated as positive
# integers, so a non-numeric value fails loud at boot instead of flowing in as NaN.
# INGEST_CHUNK_CHARS=1800
# INGEST_OVERLAP_CHARS=200

# --- Eval gates (packages/agents/src/evals/cao.eval.ts) ---
# When truthy, a gate that cannot run because its keys are missing FAILS instead of skipping
# ("skipped != passed"). Set this on the merge-to-main CI job so Gate B/C are genuinely required.
# EVAL_REQUIRE_ALL=1
# Like EVAL_REQUIRE_ALL but for the DB-backed integration gates (Gate B-integration + Gate D
# integration). Set only on the nightly job, which also wires a staging DATABASE_URL; on PRs the DB
# is absent by design so those gates skip. Ingest fixtures first: pnpm --filter @wunderstack/ingest ingest:fixtures
# EVAL_REQUIRE_DB=1
# Judge samples per case for Gate C; the median is taken (majority vote vs judge flakiness).
# Default 1; raise on the merge queue / nightly run.
# EVAL_JUDGE_SAMPLES=3
# Override the Gate C answer-generation model (default = DEFAULT_LLM_MODEL, the production generator).
# Must be EU-sovereign (enforced by @wunderstack/ai). Lets you A/B a generator without a code change.
# EVAL_GENERATION_MODEL=mistral-large-2512
# Answer-generation attempts per Gate C case in the best-of-N citation-contract loop (generate-answer.ts).
# Default 2 (= production: one generation + one repair); raise on the merge queue / nightly run.
# EVAL_GENERATION_SAMPLES=3
# When truthy, a known-good run records current metrics as the regression baseline instead of
# comparing against it (packages/agents/src/evals/fixtures/baseline.json).
# EVAL_WRITE_BASELINE=1
# GITHUB_SHA is set automatically by GitHub Actions and recorded in the per-run eval artefact
# (eval-report.json). No need to set it locally; it is simply null when absent.

# Langfuse EU Cloud tracing — used by @wunderstack/agents (CAO-agent).
# When both keys are set, every agent/model/retrieval call is exported to Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to Langfuse EU Cloud (https://cloud.langfuse.com) when unset.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Security controls (see security-audits/security-audit-latest.md) ---

# Shared secret to HMAC-verify inbound webhooks (POST /api/webhook). When UNSET the webhook rejects
# every request as unconfigured. Senders sign `${timestamp}.${rawBody}` with HMAC-SHA256 and send
# `x-wunderstack-signature` (hex) + `x-wunderstack-timestamp` (unix ms). Use a long random value.
WEBHOOK_SIGNING_SECRET=

# Comma-separated allowlist of fund keys the public chat API may serve, e.g.
# CAO_FUNDS=elektronische-detailhandel,demo
# When set, a request for a fund not in this list is refused (403) and, when several funds are
# configured, an unscoped request is refused (400) — one session = one corpus. Leave UNSET only for
# local/dev: the API then falls back to a single default fund ("demo"), never an all-funds query.
# Production MUST set this.
CAO_FUNDS=

# Comma-separated origins allowed to embed the widget iframe (/widget), e.g.
# WIDGET_ALLOWED_ORIGINS=https://www.fonds-a.nl,https://portal.fonds-b.nl
# Sets `frame-ancestors` for /widget. Unset = only same-origin ('self') may frame it.
# Read directly by next.config.mjs at boot.
WIDGET_ALLOWED_ORIGINS=
