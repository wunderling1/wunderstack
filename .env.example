# Wunderstack environment variables (example — no real values here).
#
# Keys are added per PLAN.md phase, not up front:
# Only add a key here once the code that reads it exists.

# Runtime environment. One of: development | test | production
NODE_ENV=development

# Scalingo managed Postgres (with pgvector). Used by @wunderstack/db and drizzle-kit.
# Example shape (no real values): postgres://user:password@host:5432/dbname?sslmode=require
# Also backs the Fase 1 interaction event-log (@wunderstack/analytics); when unset, event-logging
# degrades to a no-op so the demo still answers without a database.
DATABASE_URL=

# Postgres application_name prefix (pg_stat_activity). Next apps stamp a default in next.config
# (dashboard / runtime). Unset elsewhere → @wunderstack/db uses "wunderstack".
# DB_APPLICATION_NAME=wunderstack-dashboard

# Mistral (FR/EU) — default sovereign LLM provider. Used by @wunderstack/ai.
MISTRAL_API_KEY=

# Scaleway Generative APIs (EU) secret key — embeddings + reranking. Used by @wunderstack/ai.
SCALEWAY_API_KEY=

# Rerank pipeline (Fase 9). Uses SCALEWAY_API_KEY above; optional overrides:
# RERANK_ENABLED=true
# RERANK_MODEL=qwen3-embedding-8b
# RERANK_CANDIDATE_K=15
# RERANK_TOP_K=3
# RERANK_SKIP_ABOVE_SCORE=0.85

# --- Tenant identity (packages/tenant, D15) ---
# The deployment/instance identity. One instance = one tenant = one fund (1-to-1 in v1). Unset =
# local dev default ("demo" = tenant zero). The runtime reads this to scope which fund it serves.
# TENANT=oomt
# Optional explicit fund for this tenant; otherwise derived from TENANT (mapping → same-name fund).
# TENANT_FUND=elektronische-detailhandel

# --- Playground (apps/playground, tenant-zero demo UI) ---
# The playground is UI-only and proxies /api/* to the Wunderstack runtime. Point this at the
# runtime's API origin. Unset = http://localhost:3000 (the runtime dev server).
# RUNTIME_URL=https://api.wunderling.nl
# Public tenant-key for embed auth when tenant_config is configured (dashboard → Admin → Embed).
# Unset = open demo path (no key required). Safe to expose: public identifier, not a secret.
# NEXT_PUBLIC_WUNDERSTACK_TENANT_KEY=pk_...   # CAO instance (tenant_config row)
# NEXT_PUBLIC_WUNDERSTACK_TENANT_KEY_ARBO=pk_...   # Arbocatalogus instance — pnpm seed:oomt

# --- Dashboard (apps/dashboard, fund + admin, Fase 3) ---
# Auth.js (NextAuth v5) signing secret. Required to run the dashboard. Generate: openssl rand -base64 32
AUTH_SECRET=
# In deployment, set the dashboard's DATABASE_URL to the READ-ONLY analytics DB user (D4): the
# dashboard only SELECTs (KPIs + login lookup). Locally it reuses the root DATABASE_URL above. The
# `create-user` seed script needs the read-write DATABASE_URL. See DECISION-dashboard-auth.md.
# LANGFUSE_BASE_URL (below) also feeds the admin "Open in Langfuse" link.

# Optional overrides for the chunker; unset = the chunker's built-in defaults. Validated as positive
# integers, so a non-numeric value fails loud at boot instead of flowing in as NaN.
# INGEST_CHUNK_CHARS=1800
# INGEST_OVERLAP_CHARS=200

# --- Eval gates (packages/agents/src/evals/cao.eval.ts) ---
# When truthy, a gate that cannot run because its keys are missing FAILS instead of skipping
# ("skipped != passed"). Set this on the merge-to-main CI job so Gate B/C are genuinely required.
# EVAL_REQUIRE_ALL=1
# Like EVAL_REQUIRE_ALL but for the DB-backed gates (Gate B-integration, Gate D integration, G3-fund).
# CI sets it on the nightly, which brings up a throwaway Postgres + pgvector and ingests the committed
# corpora into it (ci.yml); on PRs the DB is absent by design so those gates skip. Locally, point
# DATABASE_URL at your own database and ingest first: pnpm --filter @wunderstack/ingest ingest:fixtures
# EVAL_REQUIRE_DB=1
# Judge samples per case for Gate C; the median is taken (majority vote vs judge flakiness).
# Default 1; raise on the merge queue / nightly run.
# EVAL_JUDGE_SAMPLES=3
# Override the Gate C answer-generation model (default = DEFAULT_LLM_MODEL, the production generator).
# Must be EU-sovereign (enforced by @wunderstack/ai). Lets you A/B a generator without a code change.
# EVAL_GENERATION_MODEL=mistral-large-2512
# Answer-generation attempts per Gate C case in the best-of-N citation-contract loop (generate-answer.ts).
# Default 2 (= production: one generation + one repair); raise on the merge queue / nightly run.
# EVAL_GENERATION_SAMPLES=3
# When truthy, a known-good run records current metrics as the regression baseline instead of
# comparing against it (packages/agents/src/evals/fixtures/baseline.json).
# EVAL_WRITE_BASELINE=1
# How often G2-roleplay-review re-reviews the same transcript to measure grade stability. Default 3
# (minimum 2 — below that there is no spread to measure); raise on the nightly run.
# EVAL_ROLEPLAY_REPEATS=5
# Run only these gate ids instead of the whole registry — a development convenience. Refused with a
# hard error when EVAL_REQUIRE_ALL or EVAL_REQUIRE_DB is set, and recorded in eval-report.json so a
# partial run cannot be mistaken for a full one.
# EVAL_ONLY=G1-roleplay-contract,G2-roleplay-persona,G2-roleplay-review
# Eval tier: pr | merge | nightly. Content (scaffold-quality) floors are advisory only on pr.
# Missing/unknown defaults to nightly (strict). CI sets this from the event name.
# EVAL_TIER=pr
# Comma-separated gate ids the PR diff can touch. Empty = full registry. Only legal with EVAL_TIER=pr.
# EVAL_PATH_SCOPE=G2-retrieval,G2-answer
# GITHUB_SHA is set automatically by GitHub Actions and recorded in the per-run eval artefact
# (eval-report.json). No need to set it locally; it is simply null when absent.

# Langfuse EU Cloud tracing — used by @wunderstack/agents (CAO-agent).
# When both keys are set, every agent/model/retrieval call is exported to Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to Langfuse EU Cloud (https://cloud.langfuse.com) when unset.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Security controls (see docs/security/security-audit-latest.md) ---

# Shared secret to HMAC-verify inbound webhooks (POST /api/webhook) AND to sign outbound
# roleplay-result deliveries. When UNSET the inbound webhook rejects every request as unconfigured,
# and a start with origin=webhook returns 503. Senders (and we, outbound) sign `${timestamp}.${rawBody}`
# with HMAC-SHA256 and send `x-wunderstack-signature` (hex) + `x-wunderstack-timestamp` (unix ms).
# Use a long random value. The customer's endpoint verifies with this same secret.
WEBHOOK_SIGNING_SECRET=

# Shared secrets for the MCP server (POST /api/mcp, PLAN-mcp-server). Same HMAC contract as the
# webhook. CURRENT is required when MCP is enabled; PREVIOUS stays valid during rotation (no downtime).
MCP_SIGNING_SECRET=
MCP_SIGNING_SECRET_PREVIOUS=
# Bearer tokens for MCP clients that can only send static headers (Copilot Studio, MCP Inspector,
# mcp-remote). They send `Authorization: Bearer <token>`; the per-request HMAC above is impossible
# for them. Minimum 32 chars — a static bearer has no timestamp or replay protection, so use a long
# random value (e.g. `openssl rand -hex 32`). PREVIOUS stays valid during rotation.
MCP_BEARER_TOKEN=91a56a2e594c6a7ae25626bc58b5d8e0bab8ff5aa535cb5ba99113ae4f3f164e
MCP_BEARER_TOKEN_PREVIOUS=
# Optional Host allowlist for DNS-rebinding protection, e.g. MCP_ALLOWED_HOSTS=api.example.nl
MCP_ALLOWED_HOSTS=
# Set to 1 to register the sleep stub tool (host-limit measurement). Off by default.
MCP_ENABLE_SLEEP_STUB=

# Comma-separated allowlist of fund keys the public chat API may serve, e.g.
# CAO_FUNDS=elektronische-detailhandel,demo
# When set, a request for a fund not in this list is refused (403) and, when several funds are
# configured, an unscoped request is refused (400) — one session = one corpus. Leave UNSET only for
# local/dev: the API then falls back to a single default fund ("demo"), never an all-funds query.
# Production MUST set this.
CAO_FUNDS=

# Comma-separated origins allowed to embed the widget iframe (/widget), e.g.
# WIDGET_ALLOWED_ORIGINS=https://www.fonds-a.nl,https://portal.fonds-b.nl
# Sets `frame-ancestors` for /widget. Unset = only same-origin ('self') may frame it.
# Read directly by next.config.mjs at boot.
WIDGET_ALLOWED_ORIGINS=

# --- Embed & API surface (apps/runtime + packages/embed + console, Fase 4) ---
# The runtime serves ONE tenant. Its embed config (public tenant-key, CORS allowlist, theme, texts)
# lives in control.agent_instances and is managed per agent under
# /admin/funds/<fund>/agents/<agent>/distribution. The
# runtime enforces the key for browser cross-origin calls and gates the origin via the CORS allowlist;
# an UNCONFIGURED tenant (no agent_instances row) stays open + rate-limited (tenant-zero demo / dev).

# Base URL the console puts in the generated <script src="…/embed.js"> snippet (the runtime origin for
# this fonds). Read by apps/dashboard. Defaults to http://localhost:3000 (the runtime dev server).
# Production: EMBED_SCRIPT_BASE=https://api.wunderling.nl
EMBED_SCRIPT_BASE=

# Optional dedicated writer connection for control.agent_instances and
# control.roleplay_scenarios (second DB role). The console writes theming / rotates keys /
# saves scenarios through this; falls back to DATABASE_URL when unset. Env name is a deploy alias.
# In deployment set it to a DB user granted write on those two tables only.
TENANT_CONFIG_WRITER_DATABASE_URL=

# Provisioner connection for createFundEnvironment (CREATE SCHEMA + write on control.*).
# NO fallback to DATABASE_URL — missing env fails the action visibly.
# Local: same value as DATABASE_URL. Deploy: a Scalingo login with CREATE on the database and
# write on control.*.
PROVISIONER_DATABASE_URL=

# Optional Postgres role that receives explicit SELECT on control + fund_* (never PUBLIC).
# Operator: pnpm --filter @wunderstack/db-scripts grant-reader
# DB_READER_ROLE=testadmin

# Optional Postgres role for the addon-owner / ingest / runtime login. After the provisioner
# CREATE SCHEMA, createFundEnvironment grants this role USAGE+ALL on the new fund schema so
# DATABASE_URL can ingest. Unset → skip (log); local OK when provisioner === owner.
# DB_OWNER_ROLE=wunderstack_8322


# --- Tenant zero & marketing (Fase 5) ---
# Global daily ceiling on chat requests for the whole runtime process — a coarse denial-of-wallet
# backstop for the public demo, on top of the per-IP (20/60s) and per-key (120/60s) limits. Counts
# every chat attempt that reaches the expensive path; resets at UTC midnight. Unset or 0 = disabled
# (local/dev). Set a real number on tenant zero, e.g. RUNTIME_DAILY_CAP=2000. Per process (in-memory).
RUNTIME_DAILY_CAP=

# Explicit agent for the unconfigured-open path only (0 active agent_instances, no public key).
# Local/dev and tenant zero set this to cao so a fresh clone can chat without seeding instances.
# Unset in production fonds runtimes that must not answer without an instance row.
# Unknown values fail process startup (validated against the agent registry).
RUNTIME_UNCONFIGURED_AGENT=cao

# Chat-stream robustness (POST /api/chat). Hard ceiling for one turn (retrieval + generate + repair);
# after this the route aborts work and emits a timeout error so the UI never hangs on the generating
# spinner. Unset = 45000. Keep @wunderstack/ai REQUEST_TIMEOUT_MS (>= 60000) above this so the turn
# budget fires first. Heartbeat: empty NDJSON lines during the silent buffer-to-verify phase (unset =
# 10000). Lower both under a reverse-proxy idle timeout.
# RUNTIME_CHAT_TURN_BUDGET_MS=45000
# RUNTIME_CHAT_HEARTBEAT_MS=10000

# Playground client inactivity watchdog (apps/playground use-chat). If no NDJSON bytes arrive for this
# many ms (including heartbeats), the client aborts and shows a retryable error. Unset = 20000.
# Positive integer, max 300000 (5 minutes); invalid values fall back to 20000.
# NEXT_PUBLIC_CHAT_INACTIVITY_MS=20000

# --- Roleplay learner UI (apps/roleplay, port 3004) ---
# Same RUNTIME_URL + NEXT_PUBLIC_WUNDERSTACK_TENANT_KEY as the playground: the app is UI-only and
# rewrites /api/* to the runtime. Comma-separated LMS origins allowed to iframe this app
# (`frame-ancestors`). Unset = only same-origin ('self'). Never a wildcard.
# ROLEPLAY_ALLOWED_ORIGINS=https://lms.fonds.nl
# Public origin of the roleplay app (no trailing slash). LTI 1.1 OAuth signatures and the
# post-launch redirect are computed against this host, not the internal rewrite host.
# ROLEPLAY_PUBLIC_URL=http://localhost:3004
# HMAC secret for LTI session tokens (`lid` + `exp` only — no learner identity). Min 16 chars.
# Without this, POST /api/lti11/launch returns 503. Generate with `openssl rand -hex 32`.
# LTI_SESSION_SECRET=
# Client inactivity watchdog for a roleplay turn. Same bounds as NEXT_PUBLIC_CHAT_INACTIVITY_MS.
# NEXT_PUBLIC_ROLEPLAY_INACTIVITY_MS=20000

# apps/marketing live CAO demo. The detail page injects the Fase 4 embed snippet against tenant zero
# using EMBED_SCRIPT_BASE (above; the /embed.js origin) + the demo tenant's PUBLIC key. Both must be
# set or the page shows a "not configured" note. The marketing origin must also be in the demo
# tenant's CORS allowlist (dashboard console) for the cross-origin call to succeed.
# Local: EMBED_SCRIPT_BASE=http://localhost:3000
# EMBED_PUBLIC_KEY=pk_...
