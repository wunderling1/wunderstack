# Skip pnpm's "deps out of sync with lockfile" reconciliation before running a script.
# This mirrors `verifyDepsBeforeRun: false` in pnpm-workspace.yaml, but lives here too so an
# older pnpm on the Scalingo buildpack (which reads .npmrc but not the newer workspace-yaml
# setting) also skips it. Without this, the reconciliation runs at boot and blows past
# Scalingo's fixed 60s TCP-bind deadline. Run `pnpm install` explicitly when deps change.
verify-deps-before-run=false
